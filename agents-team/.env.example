TELEGRAM_TEAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Same xray HTTP inbound the Django web service uses (docker bridge gateway)
TELEGRAM_HTTP_PROXY=http://172.18.0.1:10809
# Required on RU/Selectel VPS so Cursor SDK can reach api2.cursor.sh
HTTPS_PROXY=http://172.18.0.1:10809
HTTP_PROXY=http://172.18.0.1:10809
NODE_USE_ENV_PROXY=1
# Optional Cloudflare Worker instead of SOCKS:
# TELEGRAM_API_BASE=https://your-worker.workers.dev

# Brain for PM/analyst/SEO/backend/frontend/tester:
# cursor = Cursor SDK (repo + Telegram chat context via Agent.resume)
# groq | mistral | gemini = cheap/free cloud LLMs without repo tools
LLM_PROVIDER=cursor

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Free tier: https://console.mistral.ai → API Keys (card not required in Free mode)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Free tier: https://console.groq.com → API Keys (rate limits; revoke if leaked)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

CURSOR_API_KEY=
CURSOR_RUNTIME=cloud
CURSOR_REPO_URL=https://github.com/AnLoG21/Vmeste.git
CURSOR_REPO_REF=main
CURSOR_MODEL=composer-2.5
CURSOR_AUTO_PR=0
# Only for CURSOR_RUNTIME=local
CURSOR_WORKSPACE=/opt/vmeste

# 1 = разработчик стартует сам после плана (удобно для свободного чата)
# 0 = ждать подтверждения «да» / кнопки
DEV_AUTO=1

# Free-tier Groq: 1 concurrent call + auto-wait on HTTP 429
LLM_MAX_CONCURRENT=1
LLM_RATE_LIMIT_RETRIES=8

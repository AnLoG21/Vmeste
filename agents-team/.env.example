TELEGRAM_TEAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Same xray HTTP inbound the Django web service uses (docker bridge gateway)
TELEGRAM_HTTP_PROXY=http://172.18.0.1:10809
# Optional Cloudflare Worker instead of SOCKS:
# TELEGRAM_API_BASE=https://your-worker.workers.dev

# Brain for PM/analyst/SEO/backend/frontend/tester: gemini | mistral | groq
# groq = free rate-limited cloud (no card for free tier). Truly $0 forever = local Ollama later.
LLM_PROVIDER=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Free tier: https://console.mistral.ai → API Keys (card not required in Free mode)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Free tier: https://console.groq.com → API Keys (rate limits; revoke if leaked)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

CURSOR_API_KEY=
CURSOR_RUNTIME=cloud
CURSOR_REPO_URL=https://github.com/AnLoG21/Vmeste.git
CURSOR_REPO_REF=main
CURSOR_MODEL=composer-2.5
CURSOR_AUTO_PR=0
# Only for CURSOR_RUNTIME=local
CURSOR_WORKSPACE=/opt/vmeste

DEV_AUTO=0

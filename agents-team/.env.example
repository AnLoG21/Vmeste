TELEGRAM_TEAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# VLESS/xray SOCKS on the VPS host (agents_team uses network_mode: host)
TELEGRAM_HTTP_PROXY=socks5h://127.0.0.1:1080
# Optional Cloudflare Worker instead of SOCKS:
# TELEGRAM_API_BASE=https://your-worker.workers.dev

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

CURSOR_API_KEY=
CURSOR_RUNTIME=cloud
CURSOR_REPO_URL=https://github.com/AnLoG21/Vmeste.git
CURSOR_REPO_REF=main
CURSOR_MODEL=composer-2.5
CURSOR_AUTO_PR=0
# Only for CURSOR_RUNTIME=local
CURSOR_WORKSPACE=/opt/vmeste

DEV_AUTO=0

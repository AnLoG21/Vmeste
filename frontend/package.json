{
  "name": "vmeste-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build",
    "build:mobile": "node node_modules/vite/bin/vite.js build --mode mobile",
    "preview": "vite preview",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "cap:sync:assets": "npm run build:mobile && node scripts/sync-android-assets.mjs",
    "cap:sync:ios": "npm run build:mobile && npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run": "npm run cap:sync && npx cap run android",
    "brand:proposals": "node scripts/generate-brand-proposals.mjs",
    "brand:apply": "node scripts/apply-brand-pick.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@sentry/react": "^10.73.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "fabric": "^6.9.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "sharp": "^0.35.4"
  }
}

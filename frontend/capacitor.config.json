{
  "appId": "space.vsevmeste.app",
  "appName": "Вместе",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "scheme": "App",
    "contentInset": "automatic"
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#FFF7F0",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}

# Coverage defaults for `coverage run` / `coverage report` from backend/
[run]
branch = True
source =
    booking
    cafe
    shop
    subscriptions
    marketplaces
    inspections
    notifications
    payments
    users
    voice
    vmenu
    moy_nalog
omit =
    */migrations/*
    */management/commands/*
    */tests*.py
    */test_*.py
    */tests/*

[report]
show_missing = True
skip_empty = True
precision = 1
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError

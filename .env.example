DEBUG=1
SECRET_KEY=change-me-to-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
SKIP_EMAIL_VERIFICATION=0
FRONTEND_URL=http://localhost:5173

POSTGRES_DB=vmeste
POSTGRES_USER=vmeste_user
# Должен совпадать с POSTGRES_PASSWORD в docker-compose.yml (сервис db)
POSTGRES_PASSWORD=vmeste_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# SMS.ru (платформенный ключ; орг может задать свой в настройках)
SMSRU_API_ID=

# Платформенный Telegram-бот (один на всех; орг может задать свой token в кабинете)
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# Если VPS не достучится до api.telegram.org (Selectel и др.): URL Cloudflare Worker-прокси или socks5/http
# TELEGRAM_API_BASE=https://your-worker.workers.dev
# TELEGRAM_HTTP_PROXY=socks5h://127.0.0.1:1080

# Почта (Gmail: включите 2FA и создайте пароль приложения)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=vmesteofficialsupport@gmail.com
# 16 символов из https://myaccount.google.com/apppasswords (не обычный пароль Gmail!)
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Вместе <vmesteofficialsupport@gmail.com>
SUPPORT_EMAIL=vmesteofficialsupport@gmail.com

# ЮKassa (https://yookassa.ru) — для продакшена; без ключей подписка активируется в тестовом режиме
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Яндекс ID / VK ID (ключи только в .env на сервере, не в git)
# Redirect URI Яндекс: https://vsevmeste.space/api/users/auth/yandex/callback/
# Redirect URI VK ID:  https://vsevmeste.space/api/users/auth/vk/callback/
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=

# ИИ-описания товаров (OpenRouter). Модель: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Видео карточки генерируется в браузере; ключ на сервере не нужен
# Яндекс Диск: кнопка «Подключить» в кабинете (тот же YANDEX_OAUTH_*, в приложении Яндекса включите Disk и Redirect URI
#   https://vsevmeste.space/api/marketplaces/yandex-disk/callback/ )


# HTTPS via Let's Encrypt. Canonical host without www.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# Uploaded media from shared Docker volume (fast path)
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Динамический sitemap (организации + города) — для Яндекс.Вебмастера
	handle /sitemap.xml {
		rewrite * /api/users/sitemap.xml
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@backend path /api/* /admin* /static/*
	handle @backend {
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	handle {
		reverse_proxy frontend:80
	}
}

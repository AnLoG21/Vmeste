# HTTPS via Let's Encrypt. Canonical host without www.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	# Uploaded media from shared Docker volume (fast path)
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Динамический sitemap (организации + города) — для Яндекс.Вебмастера / Google
	handle /sitemap.xml {
		rewrite * /api/users/sitemap.xml
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# SEO HTML для роботов (Google/Yandex/соцсети) — без soft-404 и с реальным контентом
	@seo_org {
		path_regexp seo_org ^/o/([^/]+)/?$
		header_regexp ua User-Agent (?i)(Googlebot|Google-InspectionTool|Storebot-Google|bingbot|BingPreview|Yandex(Bot|RenderResourcesBot|Images|Webmaster|Metrika)|DuckDuckBot|Baiduspider|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|Applebot|SemrushBot|AhrefsBot|DotBot|PetalBot|Discordbot)
	}
	@seo_menu {
		path_regexp seo_menu ^/m/([^/]+)/?$
		header_regexp ua User-Agent (?i)(Googlebot|Google-InspectionTool|Storebot-Google|bingbot|BingPreview|Yandex(Bot|RenderResourcesBot|Images|Webmaster|Metrika)|DuckDuckBot|Baiduspider|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|Applebot|SemrushBot|AhrefsBot|DotBot|PetalBot|Discordbot)
	}
	@seo_city {
		path_regexp seo_city ^/city/(moscow|spb)/?$
		header_regexp ua User-Agent (?i)(Googlebot|Google-InspectionTool|Storebot-Google|bingbot|BingPreview|Yandex(Bot|RenderResourcesBot|Images|Webmaster|Metrika)|DuckDuckBot|Baiduspider|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|Applebot|SemrushBot|AhrefsBot|DotBot|PetalBot|Discordbot)
	}
	handle @seo_org {
		rewrite * /api/users/seo/o/{re.seo_org.1}/
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	handle @seo_menu {
		rewrite * /api/users/seo/m/{re.seo_menu.1}/
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	handle @seo_city {
		rewrite * /api/users/seo/city/{re.seo_city.1}/
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@backend path /api/* /admin* /static/*
	handle @backend {
		reverse_proxy web:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	handle {
		reverse_proxy frontend:80
	}
}
